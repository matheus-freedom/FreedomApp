// ════════════════════════════════════════════════════════════════
// FREEDOMAPP — Regras do Firestore
// ────────────────────────────────────────────────────────────────
// COMO USAR: Console do Firebase → Firestore → Regras → colar este
// conteúdo → "Laboratório de testes de regras" (simulador) → só
// então Publicar.
//
// ⚠️ POR QUE ISTO PRECISOU MUDAR AGORA
// A regra anterior terminava com um curinga:
//
//     match /{document=**} { allow write: if request.auth != null; }
//
// No Firestore, as regras são somadas (OU), não sobrepostas: se
// QUALQUER regra que casa com o caminho permite, está permitido.
// Ou seja, um curinga liberando escrita para "qualquer um logado"
// não pode ser restringido depois por uma regra mais específica —
// ela seria simplesmente ignorada.
//
// Antes da Journey isso já era ruim (o aluno podia editar o próprio
// XP). Com a Journey fica pior, porque agora existe conteúdo
// COMPARTILHADO: um único aluno com o DevTools aberto poderia
// reescrever os exercícios da coleção journey_bank — e todos os
// outros alunos da escola passariam a ver o que ele escreveu.
//
// Por isso o curinga sai e cada coleção passa a ser declarada.
//
// NOTA: o Admin SDK (as Netlify Functions) IGNORA estas regras por
// design. Então "allow write: if false" quer dizer "só o servidor
// escreve" — as functions continuam funcionando normalmente.
// ════════════════════════════════════════════════════════════════

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function logado() {
      return request.auth != null;
    }

    // É o administrador? Conferido NO BANCO (documento de quem está
    // pedindo), nunca em algo que o navegador afirme. Custa 1 leitura
    // por verificação — irrelevante no volume do app.
    function ehAdmin() {
      return logado() && ehDocDeAdmin(get(/databases/$(database)/documents/users/$(request.auth.uid)).data);
    }
    // Mesmo critério do app e das functions: isAdmin ligado OU o
    // username reservado "admin".
    function ehDocDeAdmin(d) {
      return d.get('isAdmin', false) == true || d.get('username', '').lower() == 'admin';
    }

    // ── users ────────────────────────────────────────────────
    // Leitura aberta porque a tela de login procura o e-mail pelo
    // @username ANTES de o aluno estar autenticado. (Fechar isso de
    // vez exige a coleção `usernames` do passo 2 da auditoria.)
    //
    // ESCRITA — o que mudou com a liberação de acesso:
    // Antes, qualquer aluno logado podia gravar QUALQUER campo do
    // próprio documento. Com isso, a aprovação do admin seria
    // decorativa: bastaria o aluno abrir o DevTools e escrever
    // accessStatus: 'approved' (ou isAdmin: true!) em si mesmo.
    // Agora os campos de CONTROLE só mudam pelas mãos do admin (ou do
    // servidor, que ignora estas regras):
    //     isAdmin · accessStatus · accessDecidedAt · accessDecidedBy · blockReason
    // Todo o resto (perfil, streak, contadores, seguir...) segue como
    // estava — apertar isso é o Passo 2B.
    function camposDeControle() {
      return ['isAdmin', 'accessStatus', 'accessDecidedAt', 'accessDecidedBy', 'blockReason'];
    }
    function naoMexeEmControle() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(camposDeControle());
    }
    // A ÚNICA mudança de accessStatus que o próprio aluno pode fazer:
    // clicar em "Solicitar acesso" (new/rejected → pending), mexendo
    // só nos dois campos do pedido.
    function pedidoDeAcesso(userId) {
      return request.auth.uid == userId
        && resource.data.get('accessStatus', 'approved') in ['new', 'rejected']
        && request.resource.data.accessStatus == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['accessStatus', 'accessRequestedAt']);
    }
    // Ninguém se rebatiza de "admin" (o app trata esse username como
    // administrador).
    function naoViraAdminPeloNome() {
      return request.resource.data.get('username', '').lower() != 'admin'
        || resource.data.get('username', '').lower() == 'admin';
    }
    match /users/{userId} {
      allow read: if true;
      // Conta nova: só a própria pessoa cria, sem isAdmin, e nascendo
      // SEM acesso ('new') — é o que obriga a passar pela aprovação.
      allow create: if logado() && request.auth.uid == userId
        && request.resource.data.get('isAdmin', false) == false
        && request.resource.data.get('username', '').lower() != 'admin'
        && request.resource.data.get('accessStatus', '') == 'new';
      allow update: if ehAdmin()
        || (logado() && naoViraAdminPeloNome() && (naoMexeEmControle() || pedidoDeAcesso(userId)));
      allow delete: if ehAdmin();
    }

    // ── Rastreamento de uso (dashboards do admin) ─────────────
    // Cada acesso do aluno é um documento. O aluno grava SÓ os
    // próprios acessos (o userId do documento tem que ser o dele) e
    // não lê nada; quem lê é o admin. Nenhum aluno enxerga o uso de
    // outro.
    match /sessions/{sessionId} {
      allow create: if logado() && request.resource.data.userId == request.auth.uid;
      // No update confere também o dono ATUAL do documento — senão um
      // aluno poderia "tomar" o acesso de outro trocando o userId.
      allow update: if logado() && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid;
      allow read, delete: if ehAdmin();
    }

    // Registro das decisões de acesso (aprovou/bloqueou quem, quando).
    // Escrito só pelo servidor (function admin-access).
    match /access_log/{entry} {
      allow read: if ehAdmin();
      allow write: if false;
    }

    // ── Conteúdo e progresso da Journey to Fluency ────────────
    // journey_bank guarda os exercícios COMPARTILHADOS por toda a
    // escola. Ninguém escreve pelo navegador: quem grava é a
    // function journey-content (Admin SDK). A leitura também é
    // fechada — o aluno recebe o exercício pela function, que antes
    // confere se ele pode mesmo estar naquele ponto da trilha.
    match /journey_bank/{exercicio} {
      allow read: if false;
      allow write: if false;
    }

    // O aluno LÊ o próprio progresso (é o que desenha o mapa) e não
    // escreve nada: quem grava é a function award-activity, depois
    // de conferir a nota e a posição. Sem isto, "concluí a trilha"
    // seria só uma linha digitada no console do navegador.
    match /journey_progress/{userId} {
      allow read: if (logado() && request.auth.uid == userId) || ehAdmin();
      allow write: if false;
    }

    // ── Fred explica (aulas de gramática) ─────────────────────
    // fred_lessons: conteúdo COMPARTILHADO (uma aula por tema, para
    // a escola inteira). O aluno pode LER direto — é o que permite
    // acompanhar em tempo real (onSnapshot) a aula ficando pronta —
    // mas só o servidor escreve, senão um aluno poderia reescrever
    // a aula que todos veem.
    match /fred_lessons/{aula} {
      allow read: if logado();
      allow write: if false;
    }
    // Índice leve com os ids das aulas prontas (para o catálogo).
    match /fred_meta/{doc} {
      allow read: if logado();
      allow write: if false;
    }
    // Progresso do aluno nas aulas (concluído, melhor nota, XP): ele
    // lê o próprio; quem grava é a function fred-explains depois de
    // corrigir o checkpoint no servidor.
    match /fred_progress/{userId} {
      allow read: if (logado() && request.auth.uid == userId) || ehAdmin();
      allow write: if false;
    }

    // ── Demais coleções (comportamento preservado) ────────────
    // Mesma permissão que o curinga anterior dava, só que declarada
    // coleção por coleção — para que journey_bank e journey_progress
    // acima não sejam anulados por um curinga mais frouxo.
    match /plans/{doc}              { allow read, write: if logado(); }
    match /history/{doc}            { allow read, write: if logado(); }
    match /bank/{doc}               { allow read, write: if logado(); }
    match /challenges/{doc}         { allow read, write: if logado(); }
    match /messages/{doc}           { allow read, write: if logado(); }
    match /ranking_snapshots/{doc}  { allow read, write: if logado(); }
    match /ranking_locks/{doc}      { allow read, write: if logado(); }
    match /placement_bank/{doc}     { allow read, write: if logado(); }
    match /placement_jobs/{doc}     { allow read, write: if logado(); }
    match /placement_locks/{doc}    { allow read, write: if logado(); }

    // Qualquer coleção NÃO listada acima fica fechada ao navegador.
    // É de propósito: se amanhã o código passar a usar uma coleção
    // nova, ela nasce trancada e alguém precisa decidir a regra —
    // em vez de nascer aberta e ninguém perceber.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
